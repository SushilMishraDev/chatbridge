{
  "manifest_version": 3,
  "name": "ChatBridge",
  "version": "0.3.7",
  "description": "Save your AI chats and continue them on another AI.",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "webRequest"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup/popup.html" },
  "content_scripts": [
    {
      "matches": [
        "https://*.chatgpt.com/*",
        "https://chatgpt.com/*",
        "https://*.openai.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content/page_hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.chatgpt.com/*",
        "https://chatgpt.com/*",
        "https://*.openai.com/*",
        "https://chat.openai.com/*",
        "https://*.claude.ai/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["adapters/sites.js", "content/capture.js", "content/inject.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://*.chatgpt.com/*",
        "https://*.openai.com/*",
        "https://*.claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content/auth_bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
